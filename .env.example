DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI chat / structured / evaluate via Mercury (Inception Labs).
# INCEPTION_API_KEY is also accepted as an alias for MERCURY_API_KEY.
MERCURY_API_KEY=
MERCURY_API_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_CHAT_MODEL=mercury-2.5
# Embeddings: Google Gemini Embeddings API (server-only, never expose to client).
# Get a free key at https://aistudio.google.com/apikey.
# Requires db/schema/012_embeddings_gemini2_768.sql (VECTOR(768), gemini-embedding-2 space).
GEMINI_API_KEY=
# Optional overrides (must match chunks.embedding dim via a new migration if changed):
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIM=768
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set =1 for local dev so missing Inngest keys fall back to direct processing
INNGEST_DEV=
# Admin allow-list (prototype; production would use profiles.is_admin)
# Comma-separated emails and/or user IDs that may access /admin/*
ADMIN_EMAILS=
ADMIN_USER_IDS=
