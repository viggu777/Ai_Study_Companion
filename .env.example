DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI providers (split — see lib/ai/AIService.ts header)
# Testing default: Mercury (Inception Labs) for chat/structured/evaluate.
# Production switch: set META_API_KEY (+ optional META_API_BASE_URL) — AIService
# prefers Mercury for chat only when MERCURY_API_KEY is set.
MERCURY_API_KEY=
MERCURY_API_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_CHAT_MODEL=mercury-2.5
# Chat/structured/evaluate via Meta's Llama API (api.llama.com) — production path
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1
# Embeddings: Google Gemini Embeddings API (server-only).
# Get a free key at https://aistudio.google.com/apikey — never expose to client code.
# Requires db/schema/006_embeddings_gemini_768.sql (VECTOR(768)).
# Old bge-small (384d) / nomic (768d) rows are incompatible — purge + Retry re-embeds.
GEMINI_API_KEY=
# Optional overrides (must match chunks.embedding dim via a new migration if changed):
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIM=768
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set =1 for local dev so missing Inngest keys fall back to direct processing
INNGEST_DEV=
# Admin allow-list (prototype; production would use profiles.is_admin)
# Comma-separated emails and/or user IDs that may access /admin/*
ADMIN_EMAILS=
ADMIN_USER_IDS=