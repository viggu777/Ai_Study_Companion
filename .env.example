DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI providers (split — see lib/ai/AIService.ts header)
# Testing default: Mercury (Inception Labs) for chat/structured/evaluate.
# Production switch: set META_API_KEY (+ optional META_API_BASE_URL) — AIService
# prefers Mercury for chat only when MERCURY_API_KEY is set.
MERCURY_API_KEY=
MERCURY_API_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_CHAT_MODEL=mercury-2.5
# Chat/structured/evaluate via Meta's Llama API (api.llama.com) — production path
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1
# Embeddings: local FastEmbed service by default (BAAI/bge-small-en-v1.5, 384 dims)
# Run: cd embeddings && docker compose up -d --build (see embeddings/README.md).
# Requires db/schema/004_embeddings_384.sql. Groq fallback (768 dims, needs column
# re-migration): EMBEDDING_PROVIDER=groq + valid GROQ_API_KEY.
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_API_KEY=   # only if the embeddings server requires auth
GROQ_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set =1 for local dev so missing Inngest keys fall back to direct processing
INNGEST_DEV=
# Admin allow-list (prototype; production would use profiles.is_admin)
# Comma-separated emails and/or user IDs that may access /admin/*
ADMIN_EMAILS=
ADMIN_USER_IDS=